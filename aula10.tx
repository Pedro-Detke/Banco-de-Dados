select * from tb_produto;

delete from tb_pedido where id_pedido = 9;

delete from tb_pedido where nr_quantidade < 3 and dt_pedido < '2024-02-01';

select * from tb_pedido;

select tb_categoria.tx_nome,  id_categoria, count(id_produto ) from tb_categoria  
inner join tb_produto  on tb_produto.cd_categoria = tb_categoria.id_categoria and tb_produto.fl_ativo is true
group by id_categoria, tb_categoria.tx_nome;


select tb_categoria.tx_nome, count(id_produto) from tb_categoria 
inner join tb_produto  on tb_produto.cd_categoria = tb_categoria.id_categoria
group by tb_categoria.id_categoria, tb_categoria.tx_nome
having count(id_produto)>2

create table tb_cliente(
id_cliente serial primary key,
tx_nome varchar (255) not null,
nr_idade numeric (18,0) check (nr_idade > 0),
tx_uf varchar (2) check (tx_uf = upper(tx_uf))
);

drop table tb_cliente;

insert into tb_cliente (tx_nome, nr_idade, tx_uf) values
('simone', 50, 'SC'),
('Cassia', 34, 'RJ'),
('Paula', 17, 'MG');

select * from tb_cliente;


alter table tb_pedido
add column cd_cliente integer references
tb_cliente(id_cliente)

select * from tb_pedido 


update tb_pedido set cd_cliente = 3 where id_pedido =7