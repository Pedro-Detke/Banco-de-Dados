select * from tb_curso tc;
select * from tb_professor tp;
select * from tb_professor inner join tb_disciplina on tb_disciplina.cd_professor = tb_professor.id_professor;
select * from tb_curso inner join tb_aluno on tb_aluno.cd_curso = tb_curso.id_curso;
select tb_aluno.tx_nome, tb_curso.tx_nome, tb_nota.vl_nota_1, tb_nota.vl_nota_2, tb_nota.vl_nota_3  from tb_nota inner join tb_matricula on tb_nota.cd_matricula = tb_matricula.id_matricula
inner join tb_aluno on tb_matricula.cd_aluno = tb_aluno.id_aluno
inner join tb_curso on tb_aluno.cd_curso = tb_curso.id_curso
where
((tb_nota.vl_nota_1 >= 9 and tb_nota.vl_nota_2 >8) or tb_nota.vl_nota_1 <7)

select * from tb_curso where id_curso  = 2 or id_curso  = 4;