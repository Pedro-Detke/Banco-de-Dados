create sequence seq_log start 1 increment 1;

create table tb_atv_log(
id_log numeric(18,0) default nextval('seq_log'),
tx_querry varchar(800),
nr_idade numeric(18,0),
tx_mensagem varchar(255),
cd_atividade numeric(18,0)
);

refresh materialized view vw_tudinho_materializado;






create function fn_nome(
valor numeric)
returns varchar
language plpgsql
as $$
begin
	if(valor > 18) then 
	return 
		'MAIOR DE IDADE';
	elsif (valor = 18) then
	return
		'EXATAMENTE 18 ANOS';
	return
		'MENOR DE IDADE';
	end if;
end
$$;

select *, fn_nome(id_atividade), fn_nome(50) from tb_atividade;

select current_date, age(dt_nascimento), extract(year from(dt_nascimento)) from tb_atividade;

create function fn_idade(
dt_nascimento date)
returns varchar
language plpgsql
as $$
begin
	if(
extract(year from age(dt_nascimento)) > 18) then 
	return 
		'MAIOR DE IDADE';
	elsif (
extract(year from age(dt_nascimento)) = 18) then
	return
		'EXATAMENTE 18 ANOS';
	return
		'MENOR DE IDADE';
	end if;
end
$$;

select fn_idade(dt_nascimento) from tb_atividade;

select extract(year from age(dt_nascimento)) from tb_atividade

drop function fn_acha_idade

create function fn_porcentagem(
valor numeric, percentual numeric)
returns numeric
language plpgsql
as $$
begin
	return valor * (percentual/ 100.0);
end;
$$;

select fn_porcentagem(100, 10) from tb_atividade ta;


create function calculadora
	(valor1 numeric,
		valor2 numeric, 
			operacao numeric)
returns numeric	
language plpgsql
as $$
	declare
		resultado numeric;
	begin
		case operacao
		when  1 then
			resultado := valor1 + valor2;
		when  2 then
			resultado := valor1 - valor2;
		when  3 then
			resultado := valor1 * valor2;
		when  4 then
			resultado := valor1 / valor2;
		else 
			resultado := -1;
		end case;
	
		return resultado;	
	end
$$;

select calculadora(100, 20, 3) from tb_atividade ta 


create function fn_capitalismo(valor numeric)
returns varchar
language plpgsql
as $$
begin
	if(
valor < 50) then 
	return 
		'barato';
	elsif (
valor >= 50 or valor < 200) then
	return
		'médio';
	else
	return	'tá caro';
	end if;
end
$$;


create function fn_dobro(
valor numeric)
returns numeric
language plpgsql
as $$
begin
return (valor * 2);
end
$$;

create function fn_parinpar( valor numeric )
returns varchar
language plpgsql
as $$
begin
	if(
valor %2 = 0) then 
	return 
		'par';
	else
	return 'impar';
	end if;
end
$$;

create function fn_reprova(nota numeric)
returns varchar
language plpgsql
as $$
begin
	if(
nota >= 7 and nota < 10) then 
	return 
		'Aprovado';
	elsif (
nota >= 5 and nota < 7) then
	return
		'Recuperação';
	elsif (
nota > 5 and nota > 0) then
	return
		'Reprovado';
	else
	return	'nota inválida';
	end if;
end
$$;


create or replace function log_atividade()
returns trigger
language plpgsql as $$
	begin
		insert into tb_atv_log
		(tx_querry, nr_idade, tx_mensagem, cd_atividade)
		values (
			current_query(),
			extract (year from age(
				old.dt_nascimento)),
			'MENSAGEM VIA TRIGGER',
			new.id_atividade
);
	return new;
	end;
$$;
	
	
	create trigger tr_quando_atualizar_atividade
	before update on tb_atividade
	for each row 
	execute function log_atividade();
	
	select * from tb_atv_log tal;
	
	update tb_atividade 
	set dt_nascimento = '1999-10-9',
	id_atividade = 6
	where id_atividade = 1;
	
	
create table tb_pagamentos_log(
id_pagamento numeric(18,0) default nextval('seq_pag'),
tx_query varchar (800),
tx_forma varchar (255),
vl_valor_antes numeric (18,2),
vl_valor_depois numeric (18,2),
dt_modificacao date
);

drop table tb_pagementos_log;

create sequence seq_pag start 1 increment 1;

create trigger inserir_pagamento
before insert on tb_pagamentos
for each row
execute function log_pagamento();

create or replace function log_pagamento()
returns trigger
language plpgsql as $$
	begin
		insert into tb_pagamentos_log
		(tx_query, tx_forma , vl_valor_antes, vl_valor_depois, dt_modificacao)
		values (
			current_query(),
			lower(new.tx_forma),
			old.vl_pagamento,
			new.vl_pagamento,
			now()
);
	return new;
	end;
$$;