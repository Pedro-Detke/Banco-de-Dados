create sequence seq_log start 1 increment 1;

create table tb_atv_log(
id_log numeric(18,0) default nextval('seq_log'),
tx_querry varchar(800),
nr_idade numeric(18,0),
tx_mensagem varchar(255),
cd_atividade numeric(18,0)
);

refresh materialized view vw_tudinho_materializado;






create function fn_nome(
valor numeric)
returns varchar
language plpgsql
as $$
begin
	if(valor > 18) then 
	return 
		'MAIOR DE IDADE';
	elsif (valor = 18) then
	return
		'EXATAMENTE 18 ANOS';
	return
		'MENOR DE IDADE';
	end if;
end
$$;

select *, fn_nome(id_atividade), fn_nome(50) from tb_atividade;

select current_date, age(dt_nascimento), extract(year from(dt_nascimento)) from tb_atividade;

create function fn_idade(
dt_nascimento date)
returns varchar
language plpgsql
as $$
begin
	if(
extract(year from age(dt_nascimento)) > 18) then 
	return 
		'MAIOR DE IDADE';
	elsif (
extract(year from age(dt_nascimento)) = 18) then
	return
		'EXATAMENTE 18 ANOS';
	return
		'MENOR DE IDADE';
	end if;
end
$$;

select fn_idade(dt_nascimento) from tb_atividade;

select extract(year from age(dt_nascimento)) from tb_atividade

drop function fn_acha_idade

create function fn_acha_idade(
dt_nascimento timestamp)
returns varchar
language plpgsql
as $$
declare
idade integer;
begin
idade := extract(year from age(dt_nascimento));
	if(
idade > 18) then 
	return 
		'MAIOR DE IDADE';
	elsif (
idade = 18) then
	return
		'EXATAMENTE 18 ANOS';
	else
		'MENOR DE IDADE';
	end if;
end
$$;

select fn_acha_idade(dt_nascimento) from tb_atividade;