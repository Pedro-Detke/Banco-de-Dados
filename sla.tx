create table tb_atividade(
id_atividade numeric(18,0) default nextval('seq_atividade'),
tx_nome varchar(255),
dt_nascimento timestamp default now(),
tx_genero varchar(255)
);

drop table tb_atividade;

create sequence seq_atividade start 1 increment 1;

