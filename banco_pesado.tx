explain
select * from tb_usuarios
where tx_email = 'usuario50000@exemplo.com';

create unique index
idx_usuario_email
on tb_usuarios(tx_email);

select tp.dt_pedido, tp.id_pedido, tp.vl_total from tb_pedidos tp 
where cd_usuario = 1234;

create index
idx_pedidos_usuario
on tb_pedidos(cd_usuario);

select u.tx_nome, p.id_pedido, pr.tx_nome, ip.nr_quantidade, ip.vl_unitario  from tb_usuarios u
inner join tb_pedidos p on p.cd_usuario  = u.id_usuario 
inner join tb_itens_pedido ip on ip.cd_pedido = p.id_pedido 
inner join tb_produtos pr on pr.id_produto  = ip.cd_produto 
where u.id_usuario = 1234;

create index
idx_usuarios_id
on tb_usuarios(id_usuario);
--depois 0,157s

create index
idx_itens_pedido_cd_pedido
on tb_itens_pedido(cd_pedido);
--depois 0,006s
--97% melhor

create index
idx_itens_pedido_quantidade
on tb_itens_pedido(nr_quantidade);
--depois 0,133s

--antes 0,28s

select id_pedido, tp.vl_total  from tb_pedidos tp 
where UPPER(tp.tx_status) = upper('entregue') and tp.dt_pedido >= '2023-05-23';
--0,005

create index
idx_status
on tb_pedidos(tx_status);
--60% 0,002

select tx_nome, te.nr_numero, te.tx_cidade, te.tx_logradouro  from tb_usuarios tu 
inner join tb_enderecos te on tu.id_usuario = te.cd_usuario
where te.fl_principal is true;
--0,2

create index
idx_endereco
on tb_enderecos(cd_usuario);
--88% 0,176

create view vw_pedidos_usuario as (
select
	tu.id_usuario,
	sum(tip.nr_quantidade),
	count(distinct tp2.id_pedido),
	sum ((tip.nr_quantidade * tip.vl_unitario) - tip.vl_desconto ) as liquido
from
	tb_pedidos tp2
inner join tb_usuarios tu
on
	tu.id_usuario = tp2.cd_usuario
inner join tb_itens_pedido tip
on
	tip.cd_pedido = tp2.id_pedido
where
	tp2.dt_pedido >= (now()- interval '2 years')
	and
tp2.fl_pago is true
group by
	tu.id_usuario
having
	count(tp2.id_pedido) >= 3
);

create materialized view clientes_destaque as(
with cancelados as(
select
	count(tp.id_pedido) valor,
	tp.cd_usuario
from
	tb_pedidos tp
where
	upper(tx_status) = upper('cancelado')
group by
	cd_usuario
),
media as(
select
	avg(vpu.liquido) as valor
from
	vw_pedidos_usuario vpu
)
select tu.tx_nome, vw.id_usuario, te.tx_uf, cancelados.valor from vw_pedidos_usuario vw
inner join tb_usuarios tu on vw.id_usuario = tu.id_usuario 
inner join tb_enderecos te on te.cd_usuario = tu.id_usuario 
inner join media on  vw.liquido > media.valor 
left join cancelados on cancelados.cd_usuario = vw.id_usuario 
where
tu.fl_ativo is true 
and te.fl_principal is true
);

create index
idx_usuario_usuario
on tb_usuarios(id_usuario);

select * from clientes_destaque;