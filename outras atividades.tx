create table tb_calculadora(
id_calculadora serial primary key,
nr_valor numeric(18,2) not null,
tx_operacao varchar (200) not null
);

insert into tb_calculadora(nr_valor, tx_operacao)
values(2, '+');
insert into tb_calculadora(nr_valor, tx_operacao)
values(4, '+');
insert into tb_calculadora(nr_valor, tx_operacao)
values(6, '+');
insert into tb_calculadora(nr_valor, tx_operacao)
values(8, '+');

insert into tb_calculadora(nr_valor, tx_operacao)
values(2, '-');
insert into tb_calculadora(nr_valor, tx_operacao)
values(4, '-');
insert into tb_calculadora(nr_valor, tx_operacao)
values(6, '-');
insert into tb_calculadora(nr_valor, tx_operacao)
values(8, '-');

insert into tb_calculadora(nr_valor, tx_operacao)
values(2, '*');
insert into tb_calculadora(nr_valor, tx_operacao)
values(4, '*');
insert into tb_calculadora(nr_valor, tx_operacao)
values(6, '*');
insert into tb_calculadora(nr_valor, tx_operacao)
values(8, '*');

insert into tb_calculadora(nr_valor, tx_operacao)
values(2, '/');
insert into tb_calculadora(nr_valor, tx_operacao)
values(4, '/');
insert into tb_calculadora(nr_valor, tx_operacao)
values(6, '/');
insert into tb_calculadora(nr_valor, tx_operacao)
values(8, '/');

select sum(nr_valor)from tb_calculadora where tx_operacao = '+';