create table tb_usuario(
id_usuario serial,
tx_nome varchar(255),
tx_email varchar(255),
tx_senha varchar(255),
cd_tipousuario integer not null,

constraint pk_tb_usuario primary key(id_usuario),
constraint fk_tb_usuario_cd_tipousuario foreign key (cd_tipousuario) references tb_tipousuario(id_tipousuario)
);

