create table tb_tipousuario(
id_tipousuario serial,
tx_tipo varchar(255) not null,

constraint pk_tb_tipousuario primary key(id_tipousuario)
);

insert into tb_tipousuario(nr_tipo) values('adimin', 'cliente','fornecedor');

select * from tb_usuario inner join tb_tipousuario on tb_tipousuario.id_tipousuario = tb_usuario.cd_tipousuario