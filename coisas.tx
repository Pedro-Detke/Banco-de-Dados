alter table tb_produto 
add column vl_peso numeric (18,0)

update tb_produto set vl_peso = (id_produto * vl_preco )

update tb_produto set vl_peso = 28.3 where id_produto = 12;
 
alter table tb_cliente 
add column tx_cnpj varchar(255)

alter table tb_produto 
add column tx_categoria varchar(255)

update tb_produto set tx_categoria = (select tx_categoria from tb_categoria
where tb_produto.cd_categoria = tb_categoria.id_categoria )


select * from tb_atividade
delete from tb_atividade 
where upper(tx_nome) = upper('eva costa')
