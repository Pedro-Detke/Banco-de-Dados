create table tb_aluno(
id_aluno serial,
tx_nome varchar(255),
tx_email varchar(255),
nr_telefone numeric(18,0),

constraint pk_tb_aluno primary key(id_aluno)
);

create table tb_professor(
id_professor serial,
tx_nome varchar(255),
tx_email varchar(255),
nr_telefone numeric (18,0),

constraint pk_tb_professor primary key(id_professor)
);

create table tb_disciplina(
id_disciplina serial,
tx_nome varchar(255),
nr_cargahoraria numeric (18,0),
cd_aluno integer,
cd_professor integer,

constraint fk_tb_disciplina_cd_aluno foreign key (cd_aluno) references tb_aluno(id_aluno),
constraint fk_tb_disciplina_cd_professor foreign key (cd_professor) references tb_professor(id_professor)
);

create table tb_nota(
id_nota serial,
vl_prova numeric (3,2),
cd_disciplina integer,
cd_aluno integer,

constraint fk_tb_nota_cd_aluno foreign key (cd_aluno) references tb_aluno(id_aluno),
constraint fk_tb_nota_cd_disciplina foreign key (cd_disciplina) references tb_disciplina(id_disciplina)
);